; The entry/lesson-picker screen. Hidden while a lesson/cutscene is playing;
; World.gd shows it after _ready() and whenever LessonScene emits lesson_finished.
; CanvasLayer is load-bearing here for the same reason it is in LessonScene.tscn:
; Controls parented directly to a Node2D compute to zero size against the viewport.
[node name="EntryUI" type="CanvasLayer" parent="."]
visible = false

