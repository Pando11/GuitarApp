# Copy to .env. `npm start` loads it automatically (index.js imports the
# `dotenv` dependency as its first statement) — no extra flag needed.

# Required to call the real model. Never commit the real value. If unset,
# every request falls back to template prose (see src/templateFallback.js) —
# the service still runs and responds, it just never calls the model.
ANTHROPIC_API_KEY=

# Optional. Only needed if ANTHROPIC_API_KEY is an org-level key (not scoped
# to one workspace) and the org has more than one workspace — the API then
# rejects every request with a 400 asking for this header. Value comes from
# the Anthropic Console (looks like `wrkspc_...`). Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# Port the HTTP server listens on.
PORT=8787

# Per-anonId rate limit, requests per rolling 60s window. Default 10.
COACH_RATE_LIMIT_PER_MIN=10
